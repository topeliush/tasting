rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function juontaja() {
      return request.auth != null && request.auth.token.email in ['tophaavisto@icloud.com'];
    }
    // Tastingien sisältö ja kuvat: kaikki lukevat, vain juontaja muokkaa.
    match /tastingit/{tasting} {
      allow read: if true;
      allow write: if juontaja();
      match /kuvat/{kuva} {
        allow read: if true;
        allow write: if juontaja();
      }
    }
    // Tilaisuuden tila (dia, teema, jaetut tulokset): kaikki lukevat, vain juontaja kirjoittaa.
    match /tilaisuudet/{tilaisuus} {
      allow read: if true;
      allow write: if juontaja();
      // Aromikoonti: osallistujat kasvattavat laskureita, kaikki lukevat. Vain juontaja poistaa.
      match /koonti/{v} {
        allow read: if true;
        allow create, update: if request.auth != null && v.matches('v[0-9]+|loppu')
          && request.resource.data.keys().hasOnly(['a', 'o', 't', 'L', 'm']);
        allow delete: if juontaja();
      }
      match /vastaukset/{uid} {
        // Jokainen osallistuja kirjoittaa vain omaa nimetöntä vastaustaan. Vain juontaja lukee kaikki.
        allow read: if juontaja() || (request.auth != null && request.auth.uid == uid);
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['l', 'v', 'L', 'paivitetty'])
          && request.resource.data.l in ['viini', 'alkoholiton']
          && request.resource.data.v is map;
        allow delete: if juontaja();
      }
    }
  }
}
